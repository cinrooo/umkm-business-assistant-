# .env.example
# Salin file ini ke .env.local dan isi nilai yang sesuai
# JANGAN menyimpan secret di file ini atau di source code

# ─── Database ───────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/umkm_assistant?schema=public"

# ─── NextAuth.js ────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="GANTI_DENGAN_RANDOM_STRING_32_KARAKTER"
AUTH_URL="http://localhost:3000"

# ─── Email (opsional) ───────────────────────────────────────────
# Jika tidak dikonfigurasi, fitur reset password dan invite via email
# akan dinonaktifkan secara otomatis.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="email@gmail.com"
# SMTP_PASSWORD="app_password"
# SMTP_FROM="UMKM Assistant <noreply@example.com>"

# ─── File Upload (opsional) ─────────────────────────────────────
# Jika tidak dikonfigurasi, upload gambar produk dinonaktifkan.
# Gunakan S3-compatible storage (Supabase Storage, R2, MinIO, dll)
# STORAGE_ENDPOINT=""
# STORAGE_REGION=""
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""

# ─── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="UMKM Business Assistant"
NODE_ENV="development"
